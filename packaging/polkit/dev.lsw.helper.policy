<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>LSW</vendor>
  <vendor_url>https://github.com/The1UNeed/Linux-Subsystem-for-Windows</vendor_url>
  <action id="dev.lsw.helper.gpu">
    <description>Give a graphics card to Windows, or take it back</description>
    <message>Authentication is required to change which system uses a graphics card</message>
    <icon_name>video-display</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/lsw/lsw-helper</annotate>
  </action>
</policyconfig>
