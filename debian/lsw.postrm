#!/bin/sh
set -e

#DEBHELPER#

# Give suckless-tools its /usr/bin/lsw back (see lsw.preinst).
remove_diversion() {
    dpkg-divert --package lsw --remove --rename \
        --divert /usr/bin/lsw.suckless-tools /usr/bin/lsw
}

case "$1" in
    remove|abort-install|disappear)
        remove_diversion
        ;;
    abort-upgrade)
        # Back to 0.0.1~alpha, the only version without this diversion: undo
        # the one preinst just added, as that version never removes it.
        if dpkg --compare-versions "$2" le "0.0.1~alpha"; then
            remove_diversion
        fi
        ;;
esac

exit 0
